MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/apaar_verify?retryWrites=true&w=majority
MONGODB_DATABASE=apaar_verify
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
GEMINI_API_KEY=replace-with-your-Google-AI-Studio-api-key
DEMO_MODE=false
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
DEMO_OFFICIAL_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
DEMO_VERIFIER_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
MAX_CSV_FILE_BYTES=2097152
MAX_CSV_ROWS=1000
